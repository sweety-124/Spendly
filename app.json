{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spendly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spendly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Spendly uses the camera to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Spendly uses your photo library to import receipt images."
      }
    },
    "android": {
      "package": "com.spendly.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#10B981"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-camera",
      "expo-image-picker",
      "expo-sharing"
    ]
  }
}
